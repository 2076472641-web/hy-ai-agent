# ============================================================
# 星途环球·跨境售后RAG智能问答系统 环境变量模板
# 【已默认配置为阿里云百炼(百炼)方案】
# 使用方法：
#   1) 复制本文件重命名为 .env（如已存在则直接修改）
#   2) 把下方 LLM_API_KEY=sk-xxxx 改成您在 https://bailian.console.aliyun.com/ 的真实Key
#   3) 嵌入/重排序默认保持 mock 即可零依赖运行；如需真实向量/重排，按注释切换
# ============================================================

# ------------------------------------------------------------
# 1. 大模型 LLM 配置 ⭐ 核心必填
#    阿里云百炼(百炼) - OpenAI 兼容模式
#    控制台地址: https://bailian.console.aliyun.com/
#    兼容接口 Base URL（国内通用）: https://dashscope.aliyuncs.com/compatible-mode/v1
# ------------------------------------------------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # ← ⚠️ 改成您的百炼真实API Key

# ============================================================
# 🔥 跨境RAG场景模型选型推荐（结合您的简历需求）
# ============================================================
#  需求匹配: 多语种(中英日韩德西) + 强事实遵循(不编政策) + 结构化输出 + 政策引用准确
#
#  ┌──────────────────────┬────────────────────────────────┬─────────────┬─────────────────────────────┐
#  │ 模型名               │ 特点                           │ 百炼价格    │ 推荐度(跨境RAG)            │
#  ├──────────────────────┼────────────────────────────────┼─────────────┼─────────────────────────────┤
#  │ qwen-plus            │ 多语种强、事实遵循稳、性价比高 │ ¥0.004/千token│ ⭐⭐⭐⭐⭐ 首选日常主力      │
#  │ (或 qwen2.5-72b-instruct)│                            │             │                             │
#  ├──────────────────────┼────────────────────────────────┼─────────────┼─────────────────────────────┤
#  │ qwen-max             │ 旗舰最强、合规类幻觉最少       │ ¥0.02/千token│ ⭐⭐⭐⭐ 合规类复杂问答建议 │
#  │ (或 qwen3.5-122b-a10b) │                              │             │                             │
#  ├──────────────────────┼────────────────────────────────┼─────────────┼─────────────────────────────┤
#  │ qwen-turbo           │ 超快速、最低价                 │ ¥0.001/千token│ ⭐⭐⭐ 高频简单问答/大促流量│
#  └──────────────────────┴────────────────────────────────┴─────────────┴─────────────────────────────┘
# ============================================================
LLM_MODEL=qwen-plus                                    # ← 推荐值：跨境RAG性价比+多语种最优组合

# ------------------------------------------------------------
# 2. 向量嵌入 Embedding 模型
#    mock = 离线哈希Mock，零依赖（默认）
#    如需真实向量 + 百炼 embedding，改以下两项：
#      EMBED_PROVIDER=openai_compatible
#      EMBED_MODEL=text-embedding-v3    ← 百炼官方text embedding v3 (1536维)
# ------------------------------------------------------------
EMBED_PROVIDER=mock
EMBED_MODEL=text-embedding-v3

# ------------------------------------------------------------
# 3. 重排序 Rerank 模型
#    mock = 基于词法打分Mock，零依赖（默认，够演示）
#    如需真实CrossEncoder重排，改：RERANK_PROVIDER=cross_encoder
#    并 pip install sentence-transformers（本地加载 bge-reranker-v2-m3）
#    百炼目前无原生rerank接口，推荐本地模型即可
# ------------------------------------------------------------
RERANK_PROVIDER=mock
RERANK_MODEL=bge-reranker-v2-m3

# ------------------------------------------------------------
# 4. Milvus 向量数据库（Mock模式下不用配置）
#    如需启用真实 Milvus：
#      ① 本地启动: docker run -d --name milvus-standalone -p 19530:19530 milvusdb/milvus:v2.4-latest
#      ② 在 server/app.py 中把 create_orchestrator() 的 use_mock=True 改成 False
# ------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ------------------------------------------------------------
# 5. FastAPI 服务端口
# ------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# ------------------------------------------------------------
# 6. 数据与知识库路径（默认即可，不用改）
# ------------------------------------------------------------
DATA_DIR=data
KNOWLEDGE_DIR=data/knowledge
