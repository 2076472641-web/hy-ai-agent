# ============================================================================
# 优店汇 · 商品类目智能研判分类系统
# 环境变量示例文件
# 使用方法：
#   1. 复制本文件为 .env（Windows: copy .env.example .env）
#   2. 根据实际情况修改 .env 中的值
#   3. 不要将 .env 提交到代码仓库（已加入 .gitignore）
# ============================================================================

# ============================================================================
# 一、项目路径配置
# ============================================================================

# 项目根目录（通常不需要修改，run.py会自动识别）
# PROJECT_ROOT=D:/my_work/03-classifier

# 数据根目录
DATA_DIR=./data

# 原始数据目录
RAW_DATA_DIR=./data/raw

# 预处理后数据目录
PROCESSED_DATA_DIR=./data/processed

# 模型保存根目录
MODEL_DIR=./data/models

# 日志目录
LOG_DIR=./logs

# 临时文件目录
TMP_DIR=./tmp


# ============================================================================
# 二、服务配置
# ============================================================================

# ---------- 后端 FastAPI 配置 ----------
# API服务绑定地址
API_HOST=0.0.0.0
# API服务端口
API_PORT=8000
# FastAPI调试模式（生产环境设为 false）
API_DEBUG=false
# API文档访问地址（docs页面默认启用）
API_ENABLE_DOCS=true
# CORS允许的跨域来源（逗号分隔，*=允许所有）
CORS_ORIGINS=*
# 允许上传文件最大体积（字节，默认50MB）
MAX_UPLOAD_SIZE=52428800
# 认证密钥（可留空，测试环境不启用鉴权）
# API_SECRET_KEY=your-secret-key-here

# ---------- 前端 Streamlit 配置 ----------
# 前端服务绑定地址
FRONTEND_HOST=0.0.0.0
# 前端服务端口
FRONTEND_PORT=8501
# 后端API地址（前端调用使用）
BACKEND_API_URL=http://localhost:8000


# ============================================================================
# 三、模型路径配置
# ============================================================================

# 默认加载的预测模型（优先顺序：RF, FastText, BERT）
# 填写模型目录相对路径（相对于 MODEL_DIR 或绝对路径）
DEFAULT_MODEL_RF=./data/models/random_forest_pipeline
DEFAULT_MODEL_FASTTEXT=./data/models/fasttext_pipeline
DEFAULT_MODEL_BERT=./data/models/bert_pipeline

# 优先使用的模型类型：random_forest / fasttext / bert / auto（auto=自动选最优）
PRIMARY_MODEL=auto


# ============================================================================
# 四、HuggingFace / Transformers 配置
# ============================================================================

# HuggingFace 模型缓存目录（避免C盘空间不足，建议设置到空间充足的盘）
HF_HOME=./data/models/.cache/huggingface
TRANSFORMERS_CACHE=./data/models/.cache/huggingface/transformers

# HuggingFace Hub 访问 Token（下载BERT等私有模型时需要，可留空）
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 是否启用离线模式（已下载过模型时可设为 true，避免重复联网检查）
HF_OFFLINE=false

# 默认BERT基座模型（中文场景推荐 bert-base-chinese 或 hfl/chinese-roberta-wwm-ext）
DEFAULT_BERT_BASE=bert-base-chinese


# ============================================================================
# 五、模型训练超参数
# ============================================================================

# 全局随机种子
RANDOM_SEED=42

# ---------- RandomForest ----------
RF_N_ESTIMATORS=200
RF_MAX_DEPTH=30
RF_MIN_SAMPLES_SPLIT=2
RF_TFIDF_MAX_FEATURES=8000
RF_TFIDF_NGRAM_RANGE=1,2

# ---------- FastText ----------
FT_EPOCH=30
FT_LR=0.1
FT_DIM=100
FT_WORD_NGRAMS=2
FT_MIN_COUNT=2
FT_LOSS=softmax

# ---------- BERT ----------
BERT_MAX_LENGTH=128
BERT_BATCH_SIZE=16
BERT_NUM_EPOCHS=3
BERT_LEARNING_RATE=2e-5
BERT_WARMUP_RATIO=0.1
BERT_GRADIENT_ACCUMULATION=2
# 是否启用FP16混合精度（仅支持NVIDIA GPU + CUDA）
BERT_FP16=false
# 早停耐心轮数
BERT_EARLY_STOPPING_PATIENCE=2


# ============================================================================
# 六、日志配置
# ============================================================================

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 日志文件轮转大小
LOG_ROTATION=10 MB
# 日志保留天数
LOG_RETENTION=7 days
# 是否同时输出到控制台
LOG_CONSOLE=true
# 是否同时输出到文件
LOG_FILE=true


# ============================================================================
# 七、评估 & 压缩
# ============================================================================

# 评估时是否计算 ROC / PR 曲线（慢，训练阶段可关闭）
EVAL_COMPUTE_ROC=true
EVAL_COMPUTE_PR=false

# 模型压缩 - 量化类型：dynamic / static / qat
QUANT_TYPE=dynamic
# 蒸馏训练轮数
DISTILL_EPOCHS=3
# 蒸馏温度
DISTILL_TEMPERATURE=4.0
# 蒸馏损失权重（蒸馏损失占比，剩余为真实标签CE）
DISTILL_ALPHA=0.5


# ============================================================================
# 八、数据库 & 反馈存储（可选）
# ============================================================================

# SQLite/MySQL 反馈数据存储URI（留空=使用SQLite本地默认）
# DATABASE_URL=sqlite:///./data/feedback.db
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname


# ============================================================================
# 九、其他
# ============================================================================

# CPU线程数限制（大并发推理时避免占满CPU）
# OMP_NUM_THREADS=4
# MKL_NUM_THREADS=4
# OPENBLAS_NUM_THREADS=4

# 中文分词词典（自定义词典路径，可留空）
# JIEBA_USER_DICT=./configs/jieba_dict.txt
# 停用词表（可留空使用内置）
# STOPWORDS_PATH=./configs/stopwords.txt
