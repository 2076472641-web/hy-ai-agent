# ============================================================
# 途景汇文旅多智能体一体化系统 - 环境变量示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# --- LLM 配置 ---
# 阿里千问 API Key（推荐）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# 模型名称
LLM_MODEL=qwen-plus

# 备用：兼容 OpenAI 的 LLM
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- MySQL 配置 ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=songjing_hui

# --- MCP 服务配置 ---
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# --- 智能体服务端口 ---
WEATHER_AGENT_PORT=8101
ATTRACTION_AGENT_PORT=8102
ROUTE_AGENT_PORT=8103
GATEWAY_PORT=8000

# --- Agent 通信基础 URL ---
AGENT_BASE_URL=http://localhost
WEATHER_AGENT_URL=http://localhost:8101
ATTRACTION_AGENT_URL=http://localhost:8102
ROUTE_AGENT_URL=http://localhost:8103

# --- 对话记忆配置 ---
MEMORY_DIR=./data/checkpoints
MAX_CONTEXT_TOKENS=4000
SUMMARIZER_MODEL=qwen-turbo

# --- LoRA 微调配置 ---
LORA_MODEL_PATH=./models/lora
BASE_MODEL_NAME=qwen2.5-7b-instruct
TRAIN_DATA_PATH=./data/train
OUTPUT_DIR=./models/lora-output